{
  "actions": [
    {
      "type": "comment",
      "note": "高度な設定例 - 画像認識とその他のアクションの組み合わせ"
    },
    {
      "type": "wait",
      "seconds": 2,
      "note": "初期待機"
    },
    {
      "type": "click_image",
      "image": "app_icon.png",
      "confidence": 0.85,
      "timeout": 10,
      "note": "アプリアイコンをクリックして起動"
    },
    {
      "type": "wait_for_image",
      "image": "window_ready.png",
      "timeout": 15,
      "note": "ウィンドウが開くまで待機"
    },
    {
      "type": "wait",
      "seconds": 0.5
    },
    {
      "type": "hotkey",
      "keys": ["ctrl", "a"],
      "note": "Ctrl+A (全選択)"
    },
    {
      "type": "wait",
      "seconds": 0.3
    },
    {
      "type": "press",
      "key": "delete",
      "presses": 1,
      "note": "Deleteキーを押す"
    },
    {
      "type": "wait",
      "seconds": 0.5
    },
    {
      "type": "type",
      "text": "Hello World",
      "interval": 0.05,
      "note": "テキストを入力（英数字のみ対応）"
    },
    {
      "type": "wait",
      "seconds": 1
    },
    {
      "type": "press",
      "key": "enter",
      "presses": 1,
      "note": "Enterキーを押す"
    },
    {
      "type": "wait",
      "seconds": 0.5
    },
    {
      "type": "scroll",
      "amount": -3,
      "note": "上にスクロール（負の値で上、正の値で下）"
    },
    {
      "type": "wait",
      "seconds": 1
    },
    {
      "type": "scroll",
      "amount": 3,
      "x": 500,
      "y": 500,
      "note": "座標(500,500)で下にスクロール"
    },
    {
      "type": "wait",
      "seconds": 0.5
    },
    {
      "type": "click_image",
      "image": "text_field.png",
      "clicks": 3,
      "note": "テキストフィールドをトリプルクリック（全選択）"
    },
    {
      "type": "wait",
      "seconds": 0.3
    },
    {
      "type": "click_image",
      "image": "submit_button.png",
      "offset_x": 0,
      "offset_y": 5,
      "note": "送信ボタンをクリック（Y軸に5px下にオフセット）"
    },
    {
      "type": "wait",
      "seconds": 0.5
    },
    {
      "type": "click_image",
      "image": "close_button.png",
      "confidence": 0.9,
      "grayscale": true,
      "timeout": 3,
      "note": "閉じるボタンをクリック（グレースケールで高速検索）"
    },
    {
      "type": "wait",
      "seconds": 1
    },
    {
      "type": "hotkey",
      "keys": ["ctrl", "s"],
      "note": "Ctrl+S (保存)"
    }
  ]
}
